PORT=3000
#DB_ADDRESS=mongodb://root:example@mongo:27017/weblarek?authSource=admin - использовть эту переменную окружения, если запускаем в Docker
DB_ADDRESS=mongodb://127.0.0.1:27017/weblarek?authSource=admin
UPLOAD_PATH=images
UPLOAD_PATH_TEMP=temp
ORIGIN_ALLOW=http://localhost:5173

CSRF_SECRET=csrf-secret-dev
AUTH_ACCESS_TOKEN_SECRET=access-secret-dev
AUTH_REFRESH_TOKEN_SECRET=refresh-secret-dev
AUTH_ACCESS_TOKEN_EXPIRY=1h
AUTH_REFRESH_TOKEN_EXPIRY=7d

RATE_LIMITED=true
RATE_LIMIT_POINTS=100
RATE_LIMIT_DURATION=60
